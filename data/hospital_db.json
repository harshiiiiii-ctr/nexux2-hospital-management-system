      "type": "SELECT",
      "table": "patients, beds, bills, appointments",
      "sql": "SELECT COUNT(*) AS total_patients, \n       (SELECT COUNT(*) FROM patients WHERE admission_status='Admitted') AS admitted_count, \n       (SELECT COUNT(*) FROM beds WHERE status='Available') AS available_beds, \n       (SELECT SUM(total_amount) FROM bills WHERE payment_status='Paid') AS total_revenue;",
